{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {

      "source": "~/.config/fastfetch/ghost.txt",
         "type": "file-raw",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": ">  ",
        "color": {
            "separator": "red"
        },
        "constants": [
            "───────────────────────────────────────────────────────────────────────────",
            "│\u001b[75C│\u001b[75D"
        ]
    },
    "modules": [
        {
            "format": "{#1}{#keys}╭{$1}╮\u001b[76D {user-name-colored}{at-symbol-colored}{host-name-colored} 🖥  ",
            "type": "title"
        },
        {
            "key": "{$2}{#31} kernel   ",
            "type": "kernel"
        },
        {
            "key": "{$2}{#32}󰅐 uptime   ",
            "type": "uptime"
        },
        {
            "key": "{$2}{#33}{icon} distro   ",
            "type": "os"
        },
        {
            "key": "{$2}{#34}󰇄 desktop  ",
            "type": "de"
        },
        {
            "key": "{$2}{#35} term     ",
            "type": "terminal"
        },
        {
            "key": "{$2}{#36} shell    ",
            "type": "shell"
        },
        {
            "key": "{$2}{#35}󰍛 cpu      ",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "key": "{$2}{#34}󰍛 gpu      ",
            "type": "gpu"
        },
        {
            "key": "{$2}{#33}󰉉 disk     ",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{$2}{#32} memory   ",
            "type": "memory"
        },
        {
            "key": "{$2}{#31}󰩟 network  ",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
                   "type": "wm",
                   "key": "{$2}{#36}{icon} wm       "

        },
        {
                    "type": "command",
                    "keyIcon": "",
                    "key": "{$2}{#31}{icon} rust     ",
                    "text": "rustc --version",
                    "format": "rustc {~6,13}"
                },

                {
                           "type": "command",
                           "keyIcon": "",
                           "key": "{$2}{#34}{icon} go       ",
                           "text": "go version | cut -d' ' -f3",
                           "format": "go {~2}"
                       },
                       {
                                  "type": "command",
                                  "keyIcon": "",
                                  "key": "{$2}{#33}{icon} zig      ",
                                  "text": "zig version",
                                  "format": "zig {}"
                              },
                              {
                                        "type": "command",
                                        "keyIcon": "󰊢",
                                        "key": "{$2}{#31}{icon} jj       ",
                                        "text": "jj version",
                                        "format": "jj {~1}"
                                    },
                                    {
                                                "type": "packages",
                                                "key": "{$2}{#31}{icon} packages "
                                            },
                              {
                                         "type": "editor",
                                         "key": "{$2}{#35}{icon} editor   "
                                     },
        {
                    "format": "{#1}{#keys}├{$1}┤",
                    "type": "custom"
                },
                {
                    "key": "{$2}{#39} colors   ",
                    "type": "colors",
                    "symbol": "circle"
                },
                {
                    "format": "{#1}{#keys}╰{$1}╯",
                    "type": "custom"
                }
    ]
}
